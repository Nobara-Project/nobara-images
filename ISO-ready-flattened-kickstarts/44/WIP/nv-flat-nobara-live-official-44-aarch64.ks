# Generated by pykickstart v3.52
#version=DEVEL
# Firewall configuration
firewall --enabled --service=mdns
# Keyboard layouts
keyboard 'us'
# System language
lang en_US.UTF-8
# Network information
network  --bootproto=dhcp --device=link --activate
# Shutdown after installation
shutdown
repo --name="nvidia-prod" --mirrorlist=https://mirrors.nobaraproject.org/rolling/$basearch/nvp --cost=98
repo --name="nobara" --mirrorlist=https://mirrors.nobaraproject.org/rolling/$basearch/nobara --cost=99
repo --name="nobara-updates" --mirrorlist=https://mirrors.nobaraproject.org/rolling/$basearch/baseos --cost=98
# TESTING: the kernel, kernel-eac and nobara-signed-kmods come from the
# gloriouseggroll/aarch64 COPR (unsigned, test with Secure Boot off) until
# the aarch64 kernel works; switch back to nobara-kernel-mainline after
repo --name="nobara-aarch64-test" --baseurl=https://download.copr.fedorainfracloud.org/results/gloriouseggroll/aarch64/fedora-44-aarch64/ --cost=90
repo --name="nobara-kernel-mainline" --mirrorlist=https://mirrors.nobaraproject.org/rolling/$basearch/kernel-mainline --cost=97 --excludepkgs="kernel*,kmod-*-signed-*,nobara-signed-kmods*"
repo --name="terra" --mirrorlist=https://mirrors.nobaraproject.org/rolling/$basearch/terra --excludepkgs="kernel*, akmod-xone, akmod-xpad-noone, gamescope, gamescope-session, gamescope-session-steam, flatpost, inputplumber, kmod-xone, kmod-xpad-noone, umu-launcher, umu-launcher-debuginfo, umu-launcher-debugsource, v4l2loopback, xone, xpad-noone, apparmor-debuginfo, apparmor-debugsource, apparmor-devel, apparmor-libs, apparmor-libs-debuginfo, apparmor-parser, apparmor-parser-debuginfo, apparmor-profiles, apparmor-utils, apparmor-utils-debuginfo, mod_apparmor, mod_apparmor-debuginfo, pam_apparmor, pam_apparmor-debuginfo, python3-apparmor, python3-LibAppArmor, python3-LibAppArmor-debuginfo, xone-firmware, powerbuttond"
# Root password
rootpw --lock
# SELinux configuration
selinux --disabled
# System services
services --disabled="sshd,custom-device-pollrates" --enabled="NetworkManager,inputplumber,falcond,tessel-login,dkms"
# System timezone
timezone US/Eastern
# Use network installation
url --mirrorlist="https://mirrors.nobaraproject.org/rolling/$basearch/nobara"
# X Window System configuration information
xconfig  --startxonboot
# System bootloader configuration
bootloader --location=none
# Clear the Master Boot Record
zerombr
# Partition clearing information
clearpart --all
# Disk partitioning information
part / --fstype="ext4" --size=30000

#workaround for successful nvidia graphics driver installation
%pre-install
mkdir -p /mnt/sysimage/etc/default
touch /mnt/sysimage/etc/default/grub
%end

%post
# Enable livesys services
systemctl enable livesys.service
systemctl enable livesys-late.service

# add static hostname
hostnamectl set-hostname "nobara-live"

# enable tmpfs for /tmp
systemctl enable tmp.mount

# make it so that we don't do writing to the overlay for things which
# are just tmpdirs/caches
# note https://bugzilla.redhat.com/show_bug.cgi?id=1135475
cat >> /etc/fstab << EOF
vartmp   /var/tmp    tmpfs   defaults   0  0
EOF

# work around for poor key import UI in PackageKit
rm -f /var/lib/rpm/__db*
echo "Packages within this LiveCD"
rpm -qa --qf '%{size}\t%{name}-%{version}-%{release}.%{arch}\n' |sort -rn
# Note that running rpm recreates the rpm db files which aren't needed or wanted
rm -f /var/lib/rpm/__db*

# go ahead and pre-make the man -k cache (#455968)
/usr/bin/mandb

# make sure there aren't core files lying around
rm -f /core*

# remove random seed, the newly installed instance should make it's own
rm -f /var/lib/systemd/random-seed

# convince readahead not to collect
# FIXME: for systemd

echo 'File created by kickstart. See systemd-update-done.service(8).' \
    | tee /etc/.updated >/var/.updated

# Drop the rescue kernel and initramfs, we don't need them on the live media itself.
# See bug 1317709
rm -f /boot/*-rescue*

# Disable network service here, as doing it in the services line
# fails due to RHBZ #1369794
systemctl disable network

# Remove machine-id on pre generated images
rm -f /etc/machine-id
touch /etc/machine-id

# set default GTK+ theme for root (see #683855, #689070, #808062)
cat > /root/.gtkrc-2.0 << EOF
include "/usr/share/themes/Adwaita-dark/gtk-2.0/gtkrc"
include "/etc/gtk-2.0/gtkrc"
gtk-theme-name="Adwaita-dark"
EOF
mkdir -p /root/.config/gtk-3.0
cat > /root/.config/gtk-3.0/settings.ini << EOF
[Settings]
gtk-theme-name = Adwaita-dark
EOF

# Live session: livesys has no Tessel session script, so log liveuser in
# through its "extra" hook, which livesys-main runs at every live boot before
# the display manager (tessel-login, a greetd instance). Installed systems get
# this file too, but livesys only runs with rd.live.image (live media).
mkdir -p /var/lib/livesys
cat > /var/lib/livesys/livesys-session-extra << 'EOF'
cat >> /etc/greetd/tessel-config.toml << TESSEL_EOF

[initial_session]
user = "liveuser"
command = "/usr/lib/tessel/tessel-session-launch"
TESSEL_EOF
EOF

# Make the calamares run on login
mkdir -p /home/liveuser/.config/autostart
cp -a /usr/share/applications/calamares.desktop /home/liveuser/.config/autostart/

# Add calamares installer desktop shortcut
mkdir /home/liveuser/Desktop
cp -a /usr/share/applications/calamares.desktop /home/liveuser/Desktop/
chmod a+x /home/liveuser/Desktop/*

# Create /usr/bin/liveuser_clean script
cat << 'EOF' > /home/liveuser/liveuser_clean
#!/bin/bash

rm /home/liveuser/Desktop/steam.desktop
rm /home/liveuser/Desktop/Return.desktop
rm /home/liveuser/Desktop/RemoteHost.desktop
rm /home/liveuser/.config/autostart/steam.desktop
EOF

cp /etc/xdg/autostart/org.dnf.AppCenter.Updater.desktop /home/liveuser/.config/autostart/org.dnf.AppCenter.Updater.desktop
echo "Hidden=true" >> /home/liveuser/.config/autostart/org.dnf.AppCenter.Updater.desktop

# Make the script executable
chmod +x /home/liveuser/liveuser_clean

mkdir /home/liveuser/.config/autostart/
# Create /etc/xdg/autostart/liveuser_clean.desktop
cat << 'EOF' > /home/liveuser/.config/autostart/liveuser_clean.desktop
[Desktop Entry]
Type=Application
Exec=/home/liveuser/liveuser_clean
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name[en_US]=Liveuser Clean
Name=Liveuser Clean
Comment[en_US]=Clean up desktop files for liveuser
Comment=Clean up desktop files for liveuser
EOF

# make sure to set the right permissions and selinux contexts
chown -R liveuser:liveuser /home/liveuser/
restorecon -R /home/liveuser/

# Set nobara boot theme (livemedia-creator rebuilds the live initramfs after %post)
/usr/bin/plymouth-set-default-theme nobara

# nvidia modules, update grub
cat << EOF >> /usr/share/calamares/modules/shellprocess.conf
    - command: "dracut -f --regenerate-all"
      timeout: 3600
EOF

# Lenovo ThinkPad T14s Gen 6 (Snapdragon X Elite): the installed system's
# kernels need clk_ignore_unused pd_ignore_unused too (the live ISO's GRUB
# adds them itself). Run by the installer in the new system; a no-op on
# other machines
cat << 'EOF' > /usr/libexec/nobara-board-kernel-args
#!/bin/sh
dmi=/sys/class/dmi/id
model="$(cat $dmi/product_version $dmi/product_family 2>/dev/null) $(cat $dmi/product_name 2>/dev/null)"
case "$model" in
    *"ThinkPad T14s Gen 6"*|*21N1*|*21N2*) args="clk_ignore_unused pd_ignore_unused" ;;
    *) exit 0 ;;
esac
grubby --update-kernel=ALL --args="$args"
if [ -f /etc/kernel/cmdline ]; then
    for a in $args; do
        grep -qw -- "$a" /etc/kernel/cmdline || sed -i "s/\$/ $a/" /etc/kernel/cmdline
    done
fi
EOF
chmod 755 /usr/libexec/nobara-board-kernel-args
cat << EOF >> /usr/share/calamares/modules/shellprocess.conf
    - command: "/usr/libexec/nobara-board-kernel-args"
      timeout: 60
EOF

# Calamares' displaymanager module only knows a fixed list of desktops, which
# has no Tessel. Without a desktop its greetd setup fails (it reads the
# desktop's executable unconditionally) and the install stops there. Name
# Tessel's session. Its greetd setup writes greetd's own config.toml, which
# Tessel's login screen (tessel-config.toml) does not use.
cat << EOF >> /usr/share/calamares/modules/displaymanager.conf

defaultDesktopEnvironment:
    executable: "/usr/lib/tessel/tessel-session-launch"
    desktopFile: "tessel"
EOF

# empty tmp files so unmount doesn't fail when unmounting /tmp due to kernel modules being installed
rm -Rf /tmp/*

%end


# Secure Boot. Runs on the build host (outside the image), so the Nobara
# signing key never enters the image. Nobara signs with two CAs:
#   Nobara EAC CA          GRUB and the Easy Anti-Cheat kernel (kernel-eac),
#                          which only loads modules signed by the EAC signer
#   Nobara Secure Boot CA  the normal kernel (kernel), which trusts the
#                          Nobara Secure Boot signer for modules
# The ISO boots kernel-eac (lorax aarch64.tmpl picks it), so with Secure Boot on
# it boots once the EAC CA is enrolled; the installed system can boot the
# normal kernel too once the Secure Boot CA is enrolled. Both CAs are on the
# ISO's EFI partition for MokManager (lorax efi.tmpl).
#  1. Check the boot chain shim -> GRUB -> kernel is signed by the right CA,
#     and that there is an EAC kernel for the ISO to boot.
#  2. Normal kernels: re-sign the modules DKMS/akmods built during compose
#     (NVIDIA) with the Nobara Secure Boot signer, which those kernels trust,
#     so they load with enforced signatures without enrolling a key.
#     EAC kernels: their out-of-tree modules come signed by the EAC signer
#     from the kmod-*-signed packages; check that, and that NVIDIA's signed
#     build is there when NVIDIA is in the image.
#  3. Remove the DKMS/akmods signing keys generated during compose, so every
#     install creates its own instead of sharing one private key.
# Build environment: NOBARA_SB_KEY is the Secure Boot signer key (PEM file or
# PKCS#11 URI); NOBARA_SB_CERT defaults to the image's public signer
# certificate. NOBARA_SB_ALLOW_UNSIGNED=1 builds a test ISO without signing.
%post --nochroot --erroronfail
set -euo pipefail
root="${ANA_INSTALL_PATH:-/mnt/sysimage}"
certs="$root/usr/share/nobara/eac"
sb_ca_der="$certs/nobara-sb-ca.der"
eac_ca_der="$certs/nobara-eac-ca.der"
eac_signer="$certs/nobara-eac-signer.crt"
cert="${NOBARA_SB_CERT:-$certs/nobara-sb-signer.crt}"
key="${NOBARA_SB_KEY:-}"
unsigned="${NOBARA_SB_ALLOW_UNSIGNED:-0}"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
trap 'echo "Secure Boot: the check stopped at line $LINENO (exit $?)" >&2' ERR

fail() {
    echo "Secure Boot: $*" >&2
    if [ "$unsigned" = 1 ]; then
        echo "Secure Boot: continuing because NOBARA_SB_ALLOW_UNSIGNED=1" >&2
    else
        exit 1
    fi
}

# kernel-eac.spec embeds this SBAT entry in the EAC kernel's image
eac_kernel() {
    grep -qa '^linux\.nobara-eac,' "$root/usr/lib/modules/$1/vmlinuz"
}

# Module signatures name the key by issuer and serial number
cert_serial() {
    local serial
    serial=$(openssl x509 -in "$1" -noout -serial 2>/dev/null ||
             openssl x509 -inform der -in "$1" -noout -serial)
    echo "${serial#serial=}" | tr a-f A-F
}

kernels=()
for kdir in "$root"/usr/lib/modules/*/; do
    [ -s "$kdir/vmlinuz" ] && kernels+=("$(basename "$kdir")")
done
eac_kernels=()
for kver in "${kernels[@]}"; do
    eac_kernel "$kver" && eac_kernels+=("$kver")
done

# 1. Boot chain
[ -s "$sb_ca_der" ] && [ -s "$eac_ca_der" ] && [ -s "$eac_signer" ] ||
    fail "nobara-eac-certs (>= 1.2, with both CAs) is not installed in the image"
for tool in sbverify modinfo; do
    command -v "$tool" >/dev/null || fail "$tool is missing on the build host (install sbsigntools and kmod)"
done
[ ${#eac_kernels[@]} -gt 0 ] ||
    fail "no Easy Anti-Cheat kernel in the image (install kernel-eac): with Secure Boot on, the ISO would need both CAs enrolled"
if [ -s "$sb_ca_der" ] && [ -s "$eac_ca_der" ] && command -v sbverify >/dev/null; then
    openssl x509 -inform der -in "$sb_ca_der" -out "$work/sb-ca.pem"
    openssl x509 -inform der -in "$eac_ca_der" -out "$work/eac-ca.pem"
    for efi in shimaa64.efi mmaa64.efi; do
        [ -s "$root/boot/efi/EFI/fedora/$efi" ] || fail "$efi is missing (install shim-aa64)"
    done
    for image in "$root"/boot/efi/EFI/fedora/grubaa64.efi "$root"/boot/efi/EFI/fedora/gcdaa64.efi; do
        sbverify --cert "$work/eac-ca.pem" "$image" >/dev/null 2>&1 ||
            fail "$image is not signed by the Nobara EAC CA"
    done
    for kver in "${kernels[@]}"; do
        image="$root/usr/lib/modules/$kver/vmlinuz"
        config="$root/usr/lib/modules/$kver/config"
        if eac_kernel "$kver"; then
            sbverify --cert "$work/eac-ca.pem" "$image" >/dev/null 2>&1 ||
                fail "$image (EAC kernel) is not signed by the Nobara EAC CA"
            grep -q '^CONFIG_SYSTEM_TRUSTED_KEYS=.*nobara-eac-signer' "$config" ||
                fail "$kver does not trust the Nobara EAC signer for modules"
        else
            sbverify --cert "$work/sb-ca.pem" "$image" >/dev/null 2>&1 ||
                fail "$image is not signed by the Nobara Secure Boot CA"
            grep -q '^CONFIG_SYSTEM_TRUSTED_KEYS=.*nobara-sb-signer' "$config" ||
                fail "$kver does not trust the Nobara Secure Boot signer for modules"
        fi
    done
fi

# 2. Out-of-tree modules
plain_module() {
    case "$1" in
        *.ko.zst) zstd -dcq "$1" > "$2" ;;
        *.ko.xz)  xz -dc "$1" > "$2" ;;
        *.ko.gz)  gzip -dc "$1" > "$2" ;;
        *.ko)     cp "$1" "$2" ;;
        *) return 1 ;;
    esac
}
if [ ${#eac_kernels[@]} -gt 0 ] && [ -s "$eac_signer" ]; then
    eac_serial=$(cert_serial "$eac_signer")
    for kver in "${eac_kernels[@]}"; do
        kdir="$root/usr/lib/modules/$kver"
        if rpm --root "$root" -q --quiet nvidia-kmod-common; then
            nvidia_ko=$(find "$kdir/extra" "$kdir/updates" -name 'nvidia.ko*' 2>/dev/null | head -n 1 || true)
            if [ -z "$nvidia_ko" ]; then
                fail "$kver (EAC kernel) has no NVIDIA modules: the Nobara-signed build for it (nvidia-signed-kmod-$kver) is missing or lags behind the kernel"
            else
                # The prod and nf builds both provide nvidia-signed-kmod-<kver>:
                # the one installed must match the driver in the image
                driver=$(rpm --root "$root" -q --qf '%{VERSION}' nvidia-kmod-common)
                plain_module "$nvidia_ko" "$work/nvidia.ko"
                [ "$(modinfo -F version "$work/nvidia.ko")" = "$driver" ] ||
                    fail "$kver (EAC kernel) has NVIDIA $(modinfo -F version "$work/nvidia.ko") but the image's driver is $driver"
            fi
        fi
        modules=$(find "$kdir/extra" "$kdir/updates" -name '*.ko*' 2>/dev/null || true)
        [ -n "$modules" ] || continue
        while IFS= read -r module; do
            plain_module "$module" "$work/module.ko" || continue
            sig_key=$(modinfo -F sig_key "$work/module.ko" | tr -d ':' | tr a-f A-F)
            [ "$sig_key" = "$eac_serial" ] ||
                fail "${module#"$root"} is not signed by the Nobara EAC signer; the EAC kernel won't load it"
        done <<< "$modules"
    done
fi
if [ -z "$key" ]; then
    fail "NOBARA_SB_KEY is not set, the prebuilt kernel modules would stay unsigned"
else
    serial=$(cert_serial "$cert")
    for kver in "${kernels[@]}"; do
        eac_kernel "$kver" && continue
        kdir="$root/usr/lib/modules/$kver"
        sign_file="$root/usr/src/kernels/$kver/scripts/sign-file"
        modules=$(find "$kdir/extra" "$kdir/updates" -name '*.ko*' 2>/dev/null || true)
        [ -n "$modules" ] || continue
        [ -x "$sign_file" ] || fail "kernel-devel for $kver is not installed in the image"
        while IFS= read -r module; do
            plain="$work/module.ko"
            plain_module "$module" "$plain" || continue
            # Drop the signature DKMS added with its compose-time key
            python3 - "$plain" <<'PYEOF'
import struct, sys
path = sys.argv[1]
data = open(path, "rb").read()
magic = b"~Module signature appended~\n"
if data.endswith(magic):
    sig_len = struct.unpack(">I", data[-len(magic) - 4:-len(magic)])[0]
    data = data[:len(data) - len(magic) - 12 - sig_len]
    open(path, "wb").write(data)
PYEOF
            "$sign_file" sha512 "$key" "$cert" "$plain"
            sig_key=$(modinfo -F sig_key "$plain" | tr -d ':' | tr a-f A-F)
            [ "$sig_key" = "$serial" ] ||
                fail "$module is not signed with $cert after signing"
            case "$module" in
                *.ko.zst) zstd -qf -19 "$plain" -o "$module" ;;
                *.ko.xz)  xz -c --check=crc32 --lzma2=dict=1MiB "$plain" > "$module" ;;
                *.ko.gz)  gzip -9c "$plain" > "$module" ;;
                *.ko)     cp "$plain" "$module" ;;
            esac
            echo "Secure Boot: signed ${module#"$root"}"
        done <<< "$modules"
    done
fi

# 3. Compose-time module signing keys
rm -f "$root"/var/lib/dkms/mok.key "$root"/var/lib/dkms/mok.pub
rm -f "$root"/etc/pki/akmods/private/*.priv "$root"/etc/pki/akmods/certs/*.der
%end

